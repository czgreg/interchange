[Unit]
Description=sing-box (leap-gateway data plane)
Documentation=https://sing-box.sagernet.org/
After=network-online.target feilian-tun@tun0.service
BindsTo=feilian-tun@tun0.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/sing-box check -c /etc/leap/singbox/config.json
ExecStart=/usr/local/bin/sing-box -D /var/lib/leap -c /etc/leap/singbox/config.json run
Restart=on-failure
RestartSec=5
LimitNOFILE=infinity

# Drop privileges except what we actually need: bind low ports + manage TUN.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/leap /etc/leap

[Install]
WantedBy=multi-user.target
