[Unit]
Description=mihomo (leap-gateway data plane)
Documentation=https://wiki.metacubex.one/
After=network-online.target feilian-tun@tun0.service
BindsTo=feilian-tun@tun0.service
Wants=network-online.target

[Service]
Type=simple
# Working dir = /var/lib/leap/mihomo.
# leap-gateway renders config.yaml here (matches cfg.SingBox.ConfigPath).
# mihomo reads <workdir>/config.yaml automatically when no -f is given.
# rule-sets live under <workdir>/rule-sets/ (subpath, always accepted).
# SAFE_PATHS is not needed when everything is under the working dir.
ExecStartPre=/usr/local/bin/mihomo -d /var/lib/leap/mihomo -t
ExecStart=/usr/local/bin/mihomo -d /var/lib/leap/mihomo
Restart=on-failure
RestartSec=5
LimitNOFILE=infinity

AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/leap /etc/leap

[Install]
WantedBy=multi-user.target
