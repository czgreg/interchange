#!/usr/sbin/nft -f
#
# leap-gateway nft rules — table inet leap (independent of FeiLian's table ip nat).
# Render-time placeholder @CLIENT_SUBNET@ is replaced by install.sh from
# node.client_subnet in /etc/leap/gateway.yaml.

# Idempotent: nuke and re-add. flush+delete safely no-op when the table
# doesn't exist on first install.
add table inet leap
flush table inet leap

table inet leap {
  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;

    # DNS UDP/TCP from FeiLian clients goes straight to sing-box DNS server
    # (which listens on tun0_gateway_ip:53). No fwmark — we want the kernel
    # to deliver these locally without diverting to utun-leap.
    iifname "tun0" ip saddr @CLIENT_SUBNET@ udp dport 53 accept
    iifname "tun0" ip saddr @CLIENT_SUBNET@ tcp dport 53 accept

    # Everything else from the client pool gets fwmark 0x42, which the ip rule
    # in iproute.sh routes through table 100 -> utun-leap (sing-box TUN
    # inbound). sing-box then decides direct vs proxy per geosite-cn / geoip-cn.
    iifname "tun0" ip saddr @CLIENT_SUBNET@ meta mark set 0x42
  }
}
