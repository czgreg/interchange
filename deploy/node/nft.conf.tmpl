#!/usr/sbin/nft -f
#
# leap-gateway nft rules — table inet leap (independent of FeiLian's table ip nat).
# Render-time placeholders are replaced by install.sh.

# Idempotent: nuke and re-add.
add table inet leap
flush table inet leap

table inet leap {
  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;

    # DNS UDP/TCP from FeiLian clients goes to mihomo's DNS server
    # (which listens on tun0_gateway_ip:53 — set by data_plane.dns.listen).
    # No mark needed — the kernel delivers these locally via normal routing.
    iifname "tun0" ip saddr @CLIENT_SUBNET@ udp dport 53 accept
    iifname "tun0" ip saddr @CLIENT_SUBNET@ tcp dport 53 accept

    # Non-DNS TCP/UDP is handled by iptables TPROXY rules in iproute.sh.
    # No fwmark here — TPROXY intercepts on the mangle table PREROUTING
    # hook at the same priority and routes packets to mihomo's tproxy-port,
    # preserving the original client sourceIP (10.8.x.x).
  }

  # leap-gateway API access — source-restricted.
  #
  # This chain's policy is `accept`, so an `accept` rule alone grants
  # nothing: before 2026-08-12 the rule here was `tcp dport @API_PORT@
  # accept`, which was purely decorative. With listen=0.0.0.0 and an
  # empty token that left the whole control plane open to every source
  # that could route to the node — including tun0 VPN clients, which
  # could read subscription URLs (with tokens) via GET /api/subscriptions
  # and mutate them via POST/DELETE.
  #
  # The final `drop` is what actually restricts; the accepts above it are
  # the allowlist. @API_ALLOW_RULES@ is rendered by install.sh from
  # api.allow_from (empty → loopback only).
  chain input {
    type filter hook input priority filter; policy accept;
    iif "lo" tcp dport @API_PORT@ accept
@API_ALLOW_RULES@
    tcp dport @API_PORT@ drop
  }
}
