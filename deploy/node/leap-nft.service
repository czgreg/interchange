[Unit]
Description=Inject leap nft table inet leap + fwmark policy routing
After=feilian-tun@tun0.service leap-singbox.service
BindsTo=feilian-tun@tun0.service
Wants=leap-singbox.service
# Restart with leap-singbox: when sing-box restarts, the kernel destroys
# utun-leap (along with our `default dev utun-leap` route in table 100), so
# we must re-run iproute.sh up after sing-box recreates the interface.
PartOf=leap-singbox.service
# Don't let systemd give up on us during a sing-box crash-loop.
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes

# Wait up to 60s for sing-box to create the utun-leap interface. Longer than
# the previous 30s because a sing-box config error sends it into a 5-10s
# restart loop, and we should outlast a transient one.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do ip link show utun-leap >/dev/null 2>&1 && exit 0; sleep 1; done; echo "utun-leap not present after 60s" >&2; exit 1'

ExecStart=/usr/sbin/nft -f /etc/leap/nft.conf
ExecStart=/etc/leap/iproute.sh up

# On stop / restart: tear down our nft table + ip rule + ip route. The "-"
# prefix tells systemd to ignore non-zero exit (in case nothing's installed).
ExecStop=-/usr/sbin/nft delete table inet leap
ExecStop=-/etc/leap/iproute.sh down

# Self-heal when utun-leap was unavailable on first start (sing-box was
# crash-looping). Without this, oneshot units stay in failed state forever
# even after sing-box recovers.
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
