[Unit]
Description=leap-gateway control plane (subscription fetch + data-plane render + clash-api reload)
# Control plane is independent of which proxy engine is active. install.sh
# enables exactly one of leap-singbox.service / leap-mihomo.service at deploy
# time based on cfg.SingBox.Engine; leap-gateway re-renders + reloads via
# clash-api regardless. Avoid hard Wants= to prevent the wrong engine from
# being auto-started by systemd when this unit comes up.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/leap-gateway --config /etc/leap/gateway.yaml
Restart=on-failure
RestartSec=10

# Restrict filesystem; control plane only needs config + state.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/leap /etc/leap

[Install]
WantedBy=multi-user.target
